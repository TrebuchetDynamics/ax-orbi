#!/usr/bin/env python3
"""Test stand-in for the `ax` CLI. One task, backed by a local directory.

State lives in $FAKE_AX_DIR. `resume` starts `ax-orbi-agent serve` as the
sandbox's command and `suspend` sends it SIGTERM, which is what AX's runner
does. `ssh <task> -- cmd...` runs the command against the same state.
"""
import json, os, signal, subprocess, sys, time
from pathlib import Path

root = Path(os.environ["FAKE_AX_DIR"])
state_file = root / "ax-state.json"
agent = os.environ["FAKE_AX_AGENT"]
state = json.loads(state_file.read_text()) if state_file.exists() else {}
args = sys.argv[1:]
while args and args[0] in ("-a", "--context"):
    args = args[2:]

def save():
    state_file.write_text(json.dumps(state))

def env():
    e = dict(os.environ)
    e["AX_ORBI_STATE_DIR"] = str(root / "workspace" / ".ax-orbi")
    e.update(state.get("env", {}))
    return e

def alive():
    pid = state.get("pid")
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True

cmd = args[0] if args else ""
if cmd == "version":
    print("ax fake"); sys.exit(0)
if cmd == "apply":
    text = sys.stdin.read()
    (root / "applied.yaml").write_text(text)
    if state.get("applied") and state["applied"] != text:
        print("FailedPrecondition: workspace is immutable", file=sys.stderr); sys.exit(1)
    if not state.get("applied"):
        cfg = next(l.split("value: ", 1)[1] for l in text.splitlines()
                   if "value: " in l and "source_repo" in l)
        state.update(applied=text, name=os.environ.get("FAKE_AX_TASK", "orbi-demo"),
                     phase="Suspended", env={"AX_ORBI_CONFIG": json.loads(cfg), "GH_TOKEN": "placeholder"})
        save()
    print("task created"); sys.exit(0)
if cmd == "get":
    print("NAME ATESPACE STATE ACTOR AGE")
    if state.get("applied"):
        print(f"{state['name']} default {state['phase']} {state['name']} 1m")
    sys.exit(0)
if cmd == "resume":
    if not state.get("applied"):
        print("not found", file=sys.stderr); sys.exit(1)
    if not alive():
        log = open(root / "sandbox.log", "ab")
        proc = subprocess.Popen([agent, "serve"], env=env(), stdout=log, stderr=log,
                                start_new_session=True)
        state["pid"] = proc.pid
    state["phase"] = "Working"; save()
    print("resumed"); sys.exit(0)
if cmd == "suspend":
    if alive():
        os.killpg(state["pid"], signal.SIGTERM)
        for _ in range(100):
            if not alive() or Path(f"/proc/{state['pid']}/status").read_text().count("Z (zombie)"):
                break
            time.sleep(0.1)
    state["phase"] = "Suspended"; state["pid"] = None; save()
    print("suspended"); sys.exit(0)
if cmd == "delete":
    state.clear(); save(); print("deleted"); sys.exit(0)
if cmd == "ssh":
    if state.get("phase") != "Working":
        print("task is not running", file=sys.stderr); sys.exit(1)
    rest = args[args.index("--") + 1:]
    rest[0] = agent if rest[0].endswith("ax-orbi-agent") else rest[0]
    sys.exit(subprocess.run(rest, env=env()).returncode)
print(f"fake ax: unsupported {args}", file=sys.stderr); sys.exit(2)
