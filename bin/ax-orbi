#!/usr/bin/env python3
"""ax-orbi: run Orbi + Pi inside a Google AX sandbox, one deployment per repository.

  ax-orbi check     prerequisites, version pins and the deployment config
  ax-orbi build     build the task image from versions.toml (and push it)
  ax-orbi render    print the AX manifests for a deployment
  ax-orbi prepare   create and start the sandbox; no delivery is started
  ax-orbi run       run one Orbi tick and wait for its result
  ax-orbi inspect   sandbox health, the last runs and their evidence
  ax-orbi stop      pause an enabled deployment and checkpoint its sandbox
  ax-orbi recover   bring a stopped sandbox back and report what was interrupted
  ax-orbi enable    prepare the host and enable a fleet deployment; --config registers it
  ax-orbi pause     record that a deployment should stay paused
  ax-orbi resume    re-enable a paused deployment
  ax-orbi status    list fleet deployments and their recorded modes and watch activity
  ax-orbi watch     keep enabled fleet deployments ticking outside AX

Every command takes --json. The fleet commands take --fleet; the other
commands take -c/--config (default ./ax-orbi.toml).
Exit codes: 0 ok, 1 the thing checked or run failed, 2 bad usage or config,
3 a run was interrupted or its outcome is unknown.

Standard library only; needs Python 3.11+.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
EXIT_OK, EXIT_FAILED, EXIT_USAGE, EXIT_INTERRUPTED = 0, 1, 2, 3
DEFAULT_IMAGE_REPOSITORY = "localhost:5001/ax-orbi"

NAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?\Z")
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
HOST_RE = re.compile(r"^(\*\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")
SECRET_RE = re.compile(r"^[a-z0-9]([a-z0-9.-]*[a-z0-9])?/[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")
DIGEST_RE = re.compile(r"^[^@\s]+@sha256:[0-9a-f]{64}$")
SECRET_LOOKING = re.compile(r"(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,})")

GITHUB_OPEN_HOSTS = ["codeload.github.com", "objects.githubusercontent.com",
                     "raw.githubusercontent.com", "*.githubusercontent.com"]


class ConfigError(Exception):
    pass


# ---- configuration ---------------------------------------------------------

def load_versions(path: Path | None = None) -> dict:
    with open(path or os.environ.get("AX_ORBI_VERSIONS_TOML") or ROOT / "versions.toml", "rb") as fh:
        return tomllib.load(fh)


def load_config(path: Path) -> dict:
    try:
        raw_text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc.strerror}. "
                          "Copy examples/minimal/ax-orbi.toml and edit it.") from None
    found = SECRET_LOOKING.search(raw_text)
    if found:
        raise ConfigError(f"{path} appears to contain a credential ({found.group(0)[:8]}...). "
                          "The config only references Kubernetes Secrets; remove the value "
                          "and rotate it if this file was ever shared.")
    try:
        cfg = tomllib.loads(raw_text)
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"{path}: {exc}") from None

    errors: list[str] = []

    def need(table: dict, key: str, where: str, pattern: re.Pattern | None = None,
             hint: str = "") -> str:
        value = table.get(key)
        if not isinstance(value, str) or not value:
            errors.append(f"{where}{key} is required{hint}")
            return ""
        if pattern and not pattern.match(value):
            errors.append(f"{where}{key} = {value!r} is not valid{hint}")
        return value

    need(cfg, "name", "", NAME_RE, " (lowercase letters, digits and '-', at most 50)")
    repo = cfg.get("repository") or {}
    need(repo, "source", "repository.", REPO_RE, " (OWNER/REPO)")
    repo.setdefault("base_branch", "main")
    image = cfg.get("image") or {}
    ref = need(image, "ref", "image.")
    if ref and not DIGEST_RE.match(ref):
        errors.append("image.ref must be pinned by digest (registry/name@sha256:...); "
                      "AX rejects tags. `ax-orbi build --push` prints the reference.")
    res = cfg.setdefault("resources", {})
    res.setdefault("cpu", "2")
    res.setdefault("memory", "4Gi")

    creds = cfg.get("credentials") or {}
    gh = creds.get("github") or {}
    need(gh, "secret", "credentials.github.", SECRET_RE, " (NAMESPACE/SECRET-NAME)")
    gh.setdefault("token_key", "token")
    gh.setdefault("basic_key", "basic")

    model = cfg.get("model")
    if model is not None:
        for key in ("provider", "model", "base_url"):
            need(model, key, "model.")
        url = urlparse(model.get("base_url", ""))
        if model.get("base_url") and (url.scheme != "https" or not url.hostname):
            errors.append("model.base_url must be an https URL")
        mc = creds.get("model") or {}
        need(mc, "secret", "credentials.model.", SECRET_RE, " (NAMESPACE/SECRET-NAME)")
        mc.setdefault("key", "api-key")
        mc.setdefault("header", "authorization")
        mc.setdefault("prefix", "Bearer ")
        creds["model"] = mc

    network = cfg.setdefault("network", {})
    allow = network.setdefault("allow", [])
    if not isinstance(allow, list):
        errors.append("network.allow must be a list of hostnames")
        allow = []
    for host in allow:
        if not isinstance(host, str) or not HOST_RE.match(host):
            errors.append(f"network.allow: {host!r} is not a lowercase DNS name")

    ax = cfg.setdefault("ax", {})
    ax.setdefault("atespace", "default")
    ax.setdefault("bin", "ax")
    if not isinstance(ax.setdefault("local", False), bool):
        errors.append("ax.local must be a boolean")
    orbi = cfg.setdefault("orbi", {})
    if not isinstance(orbi, dict):
        errors.append("[orbi] must be a table of Orbi settings")
    watch = cfg.setdefault("watch", {})
    if not isinstance(watch, dict):
        errors.append("[watch] must be a table")
    else:
        interval = watch.setdefault("tick_interval", 300)
        if type(interval) is not int or interval < 60:
            errors.append("watch.tick_interval must be an integer of at least 60 seconds")
        if "notify_command" in watch:
            try:
                json.dumps(watch["notify_command"], allow_nan=False)
            except (TypeError, ValueError):
                errors.append("watch.notify_command must be a value that can be saved as JSON")

    if "project" in cfg:
        project = cfg["project"]
        if not isinstance(project, dict):
            errors.append("[project] must be a table")
        else:
            for key in ("setup", "check"):
                if key == "setup" or key in project:
                    value = need(project, key, "project.")
                    if value and (Path(value).is_absolute() or ".." in Path(value).parts):
                        errors.append(f"project.{key} must be a path inside the repository")
            timeout = project.setdefault("setup_timeout", 1800)
            if type(timeout) is not int or not 60 <= timeout <= 7200:
                errors.append("project.setup_timeout must be an integer from 60 to 7200 seconds")

    if errors:
        raise ConfigError(f"{path}:\n  - " + "\n  - ".join(errors))
    cfg["repository"], cfg["image"], cfg["credentials"] = repo, image, creds
    cfg["credentials"]["github"] = gh
    return cfg


def names(cfg: dict) -> dict:
    base = f"orbi-{cfg['name']}"
    return {"task": base, "workspace": f"{base}-ws", "gateway": f"{base}-gw"}


def agent_config(cfg: dict) -> dict:
    """What the in-sandbox agent receives. No secrets by construction."""
    out = {"deployment": cfg["name"], "source_repo": cfg["repository"]["source"],
           "base_branch": cfg["repository"]["base_branch"], "orbi": cfg.get("orbi", {})}
    model = cfg.get("model")
    if model:
        out["pi"] = {k: model[k] for k in
                     ("provider", "model", "base_url", "api", "context_window", "max_tokens")
                     if k in model}
    if "project" in cfg:
        out["project"] = cfg["project"]
    return out


def secret_uri(secret: str, key: str) -> str:
    namespace, name = secret.split("/")
    return f"ate-secret://k8s.io/default/{namespace}/{name}/{key}"


def manifests(cfg: dict) -> list[dict]:
    n = names(cfg)
    atespace = cfg["ax"]["atespace"]
    creds = cfg["credentials"]
    gh = creds["github"]

    def inject(host: str, header: str, prefix: str, uri: str) -> dict:
        return {"https": {"hostnames": [host], "effects": {"replaceHeaders": [
            {"header": header, "prefix": prefix, "credentialUri": uri}]}}}

    egress = [
        # git over HTTPS sends Basic auth; gh and the REST/GraphQL API send a
        # token. Both leave the sandbox as placeholders and are replaced here.
        inject("github.com", "authorization", "Basic ", secret_uri(gh["secret"], gh["basic_key"])),
        inject("api.github.com", "authorization", "Bearer ", secret_uri(gh["secret"], gh["token_key"])),
        inject("uploads.github.com", "authorization", "Bearer ", secret_uri(gh["secret"], gh["token_key"])),
        {"https": {"hostnames": GITHUB_OPEN_HOSTS}},
    ]
    env = [{"name": "AX_ORBI_CONFIG", "value": json.dumps(agent_config(cfg), sort_keys=True)},
           {"name": "GH_TOKEN", "value": "placeholder"}]
    model = cfg.get("model")
    if model:
        mc = creds["model"]
        egress.append(inject(urlparse(model["base_url"]).hostname, mc["header"], mc["prefix"],
                             secret_uri(mc["secret"], mc["key"])))
        env.append({"name": "PI_API_KEY", "value": "placeholder"})
    extra = [h for h in cfg["network"]["allow"]]
    if extra:
        egress.append({"https": {"hostnames": extra}})

    profile = {"image": cfg["image"]["ref"],
               "resources": {"limits": {"cpu": str(cfg["resources"]["cpu"]),
                                        "memory": str(cfg["resources"]["memory"])}}}
    meta = lambda name: {"name": name, "atespace": atespace,  # noqa: E731
                         "labels": {"app": "ax-orbi", "ax-orbi/deployment": cfg["name"]}}
    gateway = {"apiVersion": "ax.io/v1alpha1", "kind": "Gateway", "metadata": meta(n["gateway"]),
               "spec": {"egress": egress}}
    workspace = {"apiVersion": "ax.io/v1alpha1", "kind": "Workspace", "metadata": meta(n["workspace"]),
                 "spec": {"profile": profile, "setup": {
                     "gateway": {"name": n["gateway"]},
                     "git": [{"name": "origin",
                              "repo": f"https://github.com/{cfg['repository']['source']}.git",
                              "ref": cfg["repository"]["base_branch"], "dir": "repo"}]}}}
    task = {"apiVersion": "ax.io/v1alpha1", "kind": "Task", "metadata": meta(n["task"]),
            "spec": {"commands": ["/usr/local/bin/ax-orbi-agent", "serve"], "env": env,
                     "workspace": {"name": n["workspace"]}, "gateway": {"name": n["gateway"]},
                     # `ax ssh` is how the host reaches the agent. It also lets
                     # anyone with access to this AX atespace run commands in
                     # the sandbox.
                     "debug": True}}
    return [gateway, workspace, task]


def to_yaml(value, indent: int = 0) -> str:
    """Block YAML for the plain dict/list/scalar trees built above."""
    pad = "  " * indent
    if isinstance(value, dict):
        out = []
        for key, item in value.items():
            if isinstance(item, (dict, list)) and item:
                out.append(f"{pad}{key}:\n{to_yaml(item, indent + 1)}")
            else:
                out.append(f"{pad}{key}: {scalar(item)}")
        return "\n".join(out)
    out = []
    for item in value:
        if isinstance(item, (dict, list)) and item:
            body = to_yaml(item, indent + 1)
            out.append(f"{pad}- {body.lstrip()}")
        else:
            out.append(f"{pad}- {scalar(item)}")
    return "\n".join(out)


def scalar(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if value in ({}, []):
        return "{}" if value == {} else "[]"
    return json.dumps(value)  # a JSON string is a valid double-quoted YAML string


def render(cfg: dict) -> str:
    return "\n---\n".join(to_yaml(doc) for doc in manifests(cfg)) + "\n"


# ---- running ax ------------------------------------------------------------

# AX's FormatTaskState labels, plus the two outcomes of looking up the task.
TASK_CLASSES = {
    "Working": "active",
    "Suspended": "checkpointed",
    "Suspending": "transitional", "Queued": "transitional",
    "Failed": "failed", "Cancelled": "failed", "Completed": "failed", "Terminating": "failed",
    "Idle": "unrecognised", "RequiresAction": "unrecognised", "Unknown": "unrecognised",
    "": "missing", None: "unreachable",
}


def ax_binary(cfg: dict | None) -> str:
    configured = (cfg or {}).get("ax", {}).get("bin", "ax")
    if configured == "ax":
        installed = state_home().absolute() / "bin" / "ax"
        if installed.exists():
            return str(installed)
    return configured


class Ax:
    def __init__(self, cfg: dict, *, start_new_session: bool = False):
        self.cfg = cfg
        self.start_new_session = start_new_session
        self.base = [ax_binary(cfg), "-a", cfg["ax"]["atespace"]]
        if cfg["ax"].get("context"):
            self.base += ["--context", cfg["ax"]["context"]]

    def run(self, *args: str, stdin: str | None = None, timeout: float = 900):
        argv = self.base + list(args)
        try:
            if not self.start_new_session:
                proc = subprocess.run(argv, input=stdin, text=True, capture_output=True, timeout=timeout)
                return proc.returncode, proc.stdout, proc.stderr
            with subprocess.Popen(argv, stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                  start_new_session=True) as proc:
                try:
                    out, err = proc.communicate(stdin, timeout=timeout)
                except subprocess.TimeoutExpired:
                    # A configured AX wrapper can be waiting on the actual CLI.
                    # Kill the group so it cannot still act after watch moves on.
                    try:
                        os.killpg(proc.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    raise
                return proc.returncode, out, err
        except FileNotFoundError:
            return 127, "", f"{self.base[0]}: not found on PATH"
        except subprocess.TimeoutExpired:
            return 124, "", f"ax {' '.join(args)}: timed out after {timeout}s"

    def task_state(self, task: str, timeout: float = 60) -> str | None:
        """An AX label, empty if absent, or None if the lookup failed."""
        code, out, _ = self.run("get", "tasks", timeout=timeout)
        if code != 0:
            return None
        for line in out.splitlines()[1:]:
            cols = line.split()
            if len(cols) >= 3 and cols[0] == task:
                return cols[2]
        return ""

    def agent(self, task: str, *args: str, timeout: float = 120,
              allow_status_error: bool = False) -> tuple[dict | None, str]:
        """Run ax-orbi-agent in the sandbox; return (parsed JSON, error)."""
        code, out, err = self.run("ssh", task, "--", "/usr/local/bin/ax-orbi-agent", *args,
                                  timeout=timeout)
        if code == 0 or allow_status_error:
            for line in reversed(out.splitlines()):
                line = line.strip()
                if line.startswith("{"):
                    try:
                        status = json.loads(line)
                    except ValueError:
                        break
                    if code == 0 or status.get("error"):
                        return status, ""
                    break
        return None, (err.strip() or out.strip() or f"ax ssh exited {code}")


# ---- output ----------------------------------------------------------------

class Report:
    def __init__(self, as_json: bool):
        self.as_json = as_json
        self.data: dict = {"checks": []}

    def check(self, name: str, ok: bool | None, detail: str, fix: str = "") -> bool:
        """ok=None is a warning: reported, never fatal."""
        entry = {"name": name, "ok": ok, "detail": detail}
        if fix and ok is not True:
            entry["fix"] = fix
        self.data["checks"].append(entry)
        if not self.as_json:
            mark = {True: "ok  ", False: "FAIL", None: "warn"}[ok]
            print(f"[{mark}] {name}: {detail}")
            if fix and ok is not True:
                print(f"       fix: {fix}")
        return ok is not False

    def say(self, text: str) -> None:
        if not self.as_json:
            print(text)

    @property
    def ok(self) -> bool:
        return all(c["ok"] is not False for c in self.data["checks"])

    def finish(self, code: int, **extra) -> int:
        self.data.update(extra)
        self.data["exitCode"] = code
        if self.as_json:
            print(json.dumps(self.data, sort_keys=True))
        return code


# ---- commands --------------------------------------------------------------

def ax_version(ax_bin: str, pinned: str) -> tuple[bool, str]:
    try:
        proc = subprocess.run([ax_bin, "version"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"could not run `ax version`: {exc}"
    line = proc.stdout.strip().partition("\n")[0]
    match = re.match(r"ax version (\S+)(?:\s|$)", line)
    version = match[1] if match else ""
    source = re.fullmatch(r"dev\+([0-9a-f]{12})(-dirty)?", version)
    if proc.returncode != 0:
        error = proc.stderr.strip().partition("\n")[0] or line or "no output"
        return False, f"`ax version` exited {proc.returncode}: {error}"
    if source and source[2]:
        return False, f"-dirty build cannot verify a clean checkout: {line}"
    if source and source[1] != pinned:
        return False, f"different commit: CLI {source[1]}, expected {pinned}"
    if source:
        return True, line
    if re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?", version):
        return False, f"release build cannot be compared with a commit pin: {line}"
    return False, f"`ax version` did not report a comparable revision: {line or 'no output'}"


def check_ax_cluster(report: Report, result: tuple[int, str, str]) -> bool:
    code, out, err = result
    detail = (err or out).strip().splitlines()
    return report.check("ax-cluster", code == 0, "control plane reachable" if code == 0 else
                        detail[-1] if detail else f"ax get tasks exited {code}",
                        "start it with `ax local start` or select a cluster with `ax ctx`; "
                        "`ax local status` shows which layer is down")


def host_checks(report: Report, cfg: dict | None, versions: dict, cluster: bool) -> None:
    report.check("python", sys.version_info >= (3, 11), sys.version.split()[0],
                 "ax-orbi needs Python 3.11 or later")
    ax_bin = ax_binary(cfg)
    found = shutil.which(ax_bin)
    report.check("ax", bool(found), found or f"{ax_bin} not found on PATH",
                 f"build the ax CLI from {versions['ax']['repo']} at {versions['ax']['ref'][:12]} "
                 "(docs/SETUP.md) and add it to PATH")
    if found:
        pinned = versions["ax"]["ref"][:12]
        verified, detail = ax_version(found, pinned)
        report.check("ax-version", verified or None, detail,
                     f"tested with google/ax {pinned}; the CLI, ax-server and the runner in the "
                     "image must come from the same commit")
    report.check("ax-server", None,
                 "server revision not verified: AX at the pinned commit does not report it")
    if cfg is None:
        return
    report.check("image-pinned", True, cfg["image"]["ref"])
    if not cluster or not found:
        return
    check_ax_cluster(report, Ax(cfg).run("get", "tasks", timeout=60))
    kubectl = shutil.which("kubectl") or shutil.which(str(Path.home() / ".ax/bin/kubectl"))
    secrets = [("github", cfg["credentials"]["github"]["secret"])]
    if cfg.get("model"):
        secrets.append(("model", cfg["credentials"]["model"]["secret"]))
    for label, secret in secrets:
        namespace, name = secret.split("/")
        if not kubectl:
            report.check(f"secret:{label}", None, f"{secret} not verified (kubectl not found)")
            continue
        cmd = [kubectl, "-n", namespace, "get", "secret", name,
               "-o", "jsonpath={.metadata.labels.ax\\.io/credential}"]
        if cfg["ax"].get("context"):
            cmd[1:1] = ["--context", cfg["ax"]["context"]]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if proc.returncode != 0:
            report.check(f"secret:{label}", False, f"{secret} not found",
                         "create it as docs/SETUP.md describes; the value never goes in the config")
        else:
            report.check(f"secret:{label}", proc.stdout.strip() == "true" or None,
                         f"{secret} exists" + ("" if proc.stdout.strip() == "true"
                                                else " but lacks the label ax.io/credential=true"),
                         f"kubectl -n {namespace} label secret {name} ax.io/credential=true")


def cmd_check(args, report: Report) -> int:
    versions = load_versions()
    cfg = None
    try:
        cfg = load_config(args.config)
        report.check("config", True, f"{args.config}: deployment {cfg['name']} for "
                                     f"{cfg['repository']['source']}")
    except ConfigError as exc:
        report.check("config", False, str(exc))
    host_checks(report, cfg, versions, cluster=not args.offline)
    unverified = [c["name"] for c in report.data["checks"] if c["ok"] is None]
    if not report.ok:
        report.say("not ready: fix the FAIL lines above")
    elif unverified:
        report.say(f"ready, with {len(unverified)} items not verified")
    else:
        report.say("ready")
    return report.finish(EXIT_OK if report.ok else EXIT_FAILED, unverified=unverified)


def build_args(versions: dict) -> dict:
    return {
        "GOLANG_IMAGE": versions["base_images"]["golang"],
        "NODE_IMAGE": versions["base_images"]["node"],
        "PYTHON_IMAGE": versions["base_images"]["python"],
        "AX_REPO": versions["ax"]["repo"], "AX_REF": versions["ax"]["ref"],
        "ORBI_REPO": versions["orbi"]["repo"], "ORBI_TAG": versions["orbi"]["tag"],
        "ORBI_COMMIT": versions["orbi"]["commit"],
        "PI_PACKAGE": versions["pi"]["package"], "PI_VERSION": versions["pi"]["version"],
        "UV_VERSION": versions["uv"]["version"],
        "GH_VERSION": versions["gh"]["version"],
        "GH_SHA256_AMD64": versions["gh"]["sha256_amd64"],
        "GH_SHA256_ARM64": versions["gh"]["sha256_arm64"],
    }


def pins_id(versions: dict) -> str:
    blob = json.dumps(build_args(versions), sort_keys=True).encode()
    files = b"".join((ROOT / "image" / name).read_bytes()
                     for name in ("Dockerfile", "ax-orbi-agent", "systemctl-shim"))
    return hashlib.sha256(blob + files).hexdigest()[:12]


def run_host_step(report: Report, step: str, argv: list[str], *, timeout: int, fix: str,
                  cwd: Path | None = None, env: dict | None = None) -> bool:
    try:
        with subprocess.Popen(argv, cwd=cwd, env=env, start_new_session=True,
                              stdout=sys.stderr if report.as_json else None) as proc:
            try:
                code = proc.wait(timeout=timeout)
            except (subprocess.TimeoutExpired, KeyboardInterrupt):
                # Make, Go and Git can start children that outlive the parent command.
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                raise
    except (OSError, subprocess.TimeoutExpired) as exc:
        return report.check(step, False, str(exc), fix)
    if code:
        return report.check(step, False, f"{' '.join(argv[:2])} exited {code}; see output above", fix)
    return True


def build_image(report: Report, repository: str, engine: str | None, push: bool) -> dict:
    versions = load_versions()
    engine = engine or shutil.which("docker") and "docker" or shutil.which("podman") and "podman"
    if not engine:
        report.check("container-engine", False, "neither docker nor podman found")
        return {}
    tag = f"{repository}:{pins_id(versions)}"
    cmd = [engine, "build", "-f", str(ROOT / "image" / "Dockerfile"), "-t", tag]
    for key, value in build_args(versions).items():
        cmd += ["--build-arg", f"{key}={value}"]
    cmd.append(str(ROOT / "image"))
    report.say(f"building {tag}")
    if not run_host_step(report, "build", cmd, timeout=3600,
                         fix="check that the container engine is running and can pull the pinned base images"):
        return {}
    report.check("build", True, tag)
    ref = None
    if push:
        push_cmd = [engine, "push", tag]
        if engine == "podman" and re.match(r"^(localhost|127\.0\.0\.1)(:\d+)?/", tag):
            push_cmd.insert(2, "--tls-verify=false")
        if not run_host_step(report, "push", push_cmd, timeout=3600,
                             fix="check the registry address and that you are logged in to it"):
            return {}
        fix = f"resolve it with `{engine} buildx imagetools inspect {tag}`"
        try:
            proc = subprocess.run([engine, "image", "inspect", "--format", "{{json .RepoDigests}}", tag],
                                  capture_output=True, text=True, timeout=60, check=True)
            digests = json.loads(proc.stdout or "null")
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            report.check("push", False, f"pushed, but could not read the digest: {exc}", fix)
            return {"tag": tag}
        if isinstance(digests, list):
            ref = next((d for d in digests if isinstance(d, str) and d.startswith(repository + "@")
                        and DIGEST_RE.fullmatch(d)), None)
        if not report.check("push", bool(ref), ref or "pushed, but no digest was reported", fix):
            return {"tag": tag}
    return {"tag": tag, "ref": ref}


def cmd_build(args, report: Report) -> int:
    image = build_image(report, args.repository, args.engine, args.push)
    if image.get("ref"):
        report.say(f'\nset this in your deployment config:\n\n[image]\nref = "{image["ref"]}"')
    return report.finish(EXIT_OK if report.ok else EXIT_FAILED, **image)


def cmd_render(args, report: Report) -> int:
    cfg = load_config(args.config)
    if report.as_json:
        return report.finish(EXIT_OK, manifests=manifests(cfg))
    sys.stdout.write(render(cfg))
    return EXIT_OK


def wait_for_agent(ax: Ax, task: str, deadline: float):
    """Poll until the supervisor has finished prepare, within the startup budget."""
    status, err = None, "no answer yet"
    while (remaining := deadline - time.monotonic()) > 0:
        status, err = ax.agent(task, "status", "--json", timeout=min(120, remaining))
        if status and status.get("started"):
            return status, ""
        time.sleep(min(3, max(0, deadline - time.monotonic())))
    return status, err or "the agent's supervisor did not come up in time"


def report_task_error(report: Report, task: str, state: str | None, kind: str) -> int:
    if kind == "missing":
        report.check("task", False, f"task {task} does not exist", "create it with `ax-orbi prepare`")
        return EXIT_FAILED
    if kind == "unreachable":
        report.check("task", False, "cannot reach the AX control plane",
                     "`ax local status` or `ax ctx` shows what is down")
        return EXIT_FAILED
    detail = (f"{task} reported unrecognised state {state!r}" if kind == "unrecognised"
              else f"{task} is {state}")
    report.check("task", False, detail, f"check with `ax describe task {task}`")
    return EXIT_FAILED if kind == "failed" else EXIT_INTERRUPTED


def ensure_working(ax: Ax, task: str, report: Report, deadline: float) -> int:
    state = ax.task_state(task, timeout=min(60, max(1, deadline - time.monotonic())))
    while TASK_CLASSES.get(state) == "transitional":
        time.sleep(min(1, max(0, deadline - time.monotonic())))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        next_state = ax.task_state(task, timeout=min(60, remaining))
        if next_state is None and time.monotonic() >= deadline:
            break  # Still transitioning when the polling budget ran out.
        state = next_state
    report.data["taskState"] = "NotFound" if state == "" else state
    kind = TASK_CLASSES.get(state, "unrecognised")
    if kind == "active":
        report.check("task", True, f"{task} is {state}")
        return EXIT_OK
    if kind != "checkpointed":
        return report_task_error(report, task, state, kind)
    code, out, err = ax.run("resume", "task", task)
    report.check("task", code == 0,
                 f"{task} resumed (was {state})" if code == 0 else (err or out).strip(),
                 f"`ax describe task {task}` shows the failing condition")
    return EXIT_OK if code == 0 else EXIT_FAILED


def report_prepare(report: Report, status: dict | None, err: str) -> bool:
    if not status:
        return report.check("agent", False, f"no answer from the agent: {err}",
                            "the sandbox may still be starting; `ax-orbi inspect` retries. "
                            "If it persists, check `ax describe task`")
    report.check("agent", bool(status.get("supervisorAlive")),
                 "supervisor alive" if status.get("supervisorAlive") else "supervisor is not running",
                 "inspect the sandbox, or use `ax-orbi stop --force` then `ax-orbi recover`")
    prep = status.get("prepare")
    if prep is None:
        return report.check("image-pins", False,
                            "image pins not verified: no prepare report for this boot",
                            "retry `ax-orbi inspect` after the supervisor finishes starting"
                            if status.get("supervisorAlive") else "")
    for item in prep.get("checks", []):
        report.check(f"sandbox:{item['name']}", item["ok"], item["detail"], item.get("fix", ""))
    versions = load_versions()
    expected = {
        "ax_ref": versions["ax"]["ref"], "orbi_tag": versions["orbi"]["tag"],
        "orbi_commit": versions["orbi"]["commit"], "pi_version": versions["pi"]["version"],
        "gh_version": versions["gh"]["version"],
    }
    image = prep.get("image")
    image = image if isinstance(image, dict) else {}
    differences = []
    for pin, value in expected.items():
        if image.get(pin) != value:
            reported = repr(image[pin]) if pin in image else "<missing>"
            differences.append(f"{pin}: image {reported}, expected {value!r}")
    pins_match = report.check("image-pins", not differences,
                              "; ".join(differences) or "image pins match versions.toml",
                              "rebuild with `ax-orbi build --push`, set the new image digest, "
                              "and prepare a deployment with a new `name`")
    return bool(prep.get("ok")) and bool(status.get("supervisorAlive")) and pins_match


def cmd_prepare(args, report: Report) -> int:
    cfg = load_config(args.config)
    host_checks(report, cfg, load_versions(), cluster=True)
    if not report.ok:
        return report.finish(EXIT_FAILED)
    ax, n = Ax(cfg), names(cfg)
    code, out, err = ax.run("apply", "-f", "-", stdin=render(cfg))
    detail = (out + err).strip()
    fix = ""
    if "FailedPrecondition" in detail or "immutable" in detail.lower():
        fix = ("Workspaces and Tasks are immutable. To change image, repository, limits or network, "
               f"use a new `name` in the config, or delete this deployment first: ax-orbi stop --delete")
    if not report.check("apply", code == 0, detail.replace("\n", "; ") or "applied", fix):
        return report.finish(EXIT_FAILED)
    deadline = time.monotonic() + args.timeout
    code = ensure_working(ax, n["task"], report, deadline)
    if code != EXIT_OK:
        return report.finish(code)
    status, err = wait_for_agent(ax, n["task"], deadline)
    ready = report_prepare(report, status, err)
    report.say("prepared; no delivery was started. Run a tick with `ax-orbi run`."
               if ready else "the sandbox is up but not ready for a tick; fix the FAIL lines above")
    return report.finish(EXIT_OK if ready and report.ok else EXIT_FAILED, task=n["task"])


def describe_run(report: Report, run: dict) -> None:
    report.say(f"run {run.get('id')}: {run.get('status')}"
               + (f" (exit {run['exitCode']})" if "exitCode" in run else ""))
    if run.get("detail"):
        report.say(f"  {run['detail']}")
    if run.get("log"):
        report.say(f"  log: {run['log']} (in the sandbox; `ax-orbi inspect --run {run.get('id')} --logs`)")


def run_exit(run: dict | None) -> int:
    status = (run or {}).get("status")
    if status == "succeeded":
        return EXIT_OK
    if status == "failed":
        return EXIT_FAILED
    return EXIT_INTERRUPTED


def cmd_run(args, report: Report) -> int:
    cfg = load_config(args.config)
    ax, n = Ax(cfg), names(cfg)
    deadline = time.monotonic() + args.start_timeout
    code = ensure_working(ax, n["task"], report, deadline)
    if code != EXIT_OK:
        return report.finish(code)
    status, err = wait_for_agent(ax, n["task"], deadline)
    if not report_prepare(report, status, err):
        report.say("not running a tick: the sandbox is not ready")
        return report.finish(EXIT_FAILED)
    request = ["request-tick"] + (["--id", args.id] if args.id else [])
    answer, err = ax.agent(n["task"], *request)
    if not answer:
        report.check("request", False, f"could not request a tick: {err}")
        return report.finish(EXIT_INTERRUPTED)
    run_id = answer["id"]
    report.check("request", True, f"tick {run_id}" + (" (already requested; not started again)"
                                                      if answer.get("duplicate") else " requested"))
    run = answer.get("run") or {}
    deadline = time.monotonic() + args.timeout if args.timeout else None
    misses = 0
    while run.get("status") not in ("succeeded", "failed", "interrupted"):
        if args.no_wait:
            break
        if deadline and time.monotonic() > deadline:
            report.say(f"still running after {args.timeout}s; the tick continues in the sandbox. "
                       f"Check later with: ax-orbi inspect --run {run_id}")
            return report.finish(EXIT_INTERRUPTED, run=run)
        time.sleep(args.poll)
        status, err = ax.agent(n["task"], "status", "--json", "--run", run_id)
        if not status or not status.get("runs"):
            misses += 1
            if misses >= 10:
                report.check("poll", False, f"lost contact with the sandbox: {err}",
                             f"the outcome is unknown, not failed. Check: ax-orbi inspect --run {run_id}")
                return report.finish(EXIT_INTERRUPTED, run=run)
            continue
        misses = 0
        run = status["runs"][0]
    describe_run(report, run)
    return report.finish(run_exit(run) if not args.no_wait else EXIT_OK, run=run)


def cmd_inspect(args, report: Report) -> int:
    cfg = load_config(args.config)
    ax, n = Ax(cfg), names(cfg)
    state = ax.task_state(n["task"])
    report.data["taskState"] = "NotFound" if state == "" else state
    kind = TASK_CLASSES.get(state, "unrecognised")
    if kind == "checkpointed":
        report.check("task", None, f"{n['task']} is {state}: the sandbox is checkpointed, "
                                   "its state is kept, and nothing is running",
                     "bring it back with `ax-orbi recover`")
        return report.finish(EXIT_OK)
    if kind != "active":
        return report.finish(report_task_error(report, n["task"], state, kind))
    report.check("task", True, f"{n['task']} is {state}")
    extra = ["--run", args.run] if args.run else ["--limit", str(args.limit)]
    # `status --run` exits nonzero with a structured error for a missing run.
    status, err = ax.agent(n["task"], "status", "--json", *extra, allow_status_error=bool(args.run))
    ready = report_prepare(report, status, err)
    runs = (status or {}).get("runs", [])
    if status and status.get("error"):
        report.check("run", False, status["error"])
    health = status.get("health") if status and status.get("supervisorAlive") is True else None
    health = health or {}
    report.say(f"supervisor state: {health.get('state', '?')}"
               + (f", running {health['currentRun']}" if health.get("currentRun") else "")
               + f"; runs: {json.dumps((status or {}).get('counts', {}), sort_keys=True)}")
    for run in runs:
        describe_run(report, run)
    logs = None
    if args.logs and (args.run or runs):
        run_id = args.run or runs[-1]["id"]
        code, out, err = ax.run("ssh", n["task"], "--", "/usr/local/bin/ax-orbi-agent",
                                "logs", "--run", run_id, "--tail", str(args.tail))
        logs = out
        report.say(f"--- last {args.tail} log lines of {run_id} ---\n{out.rstrip()}")
    return report.finish(EXIT_OK if ready and report.ok else EXIT_FAILED, status=status, logs=logs)


def xdg_orbi_dir(variable: str, default: str) -> Path:
    return Path(os.environ.get(variable) or Path.home() / default) / "ax-orbi"


def fleet_dir(override: Path | None) -> Path:
    return (override or Path(os.environ.get("AX_ORBI_FLEET") or
                             xdg_orbi_dir("XDG_CONFIG_HOME", ".config") / "deployments")).absolute()


def state_home() -> Path:
    return Path(os.environ.get("AX_ORBI_HOME") or xdg_orbi_dir("XDG_STATE_HOME", ".local/state"))


def desired_path(name: str) -> Path:
    return state_home() / "deployments" / name / "desired.json"


def read_state(path: Path) -> dict | None:
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except ValueError as exc:
        raise ValueError(f"invalid state in {path}: {exc}") from None
    if not isinstance(state, dict):
        raise ValueError(f"expected a JSON object in {path}")
    return state


def read_desired(path: Path) -> dict | None:
    state = read_state(path)
    if state is not None and state.get("mode") not in ("enabled", "paused"):
        raise ValueError(f"expected mode enabled or paused in {path}")
    return state


def write_state(path: Path, record: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fh = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False)
    tmp = Path(fh.name)
    try:
        with fh:
            json.dump(record, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        tmp.replace(path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        tmp.unlink(missing_ok=True)


def write_desired(path: Path, mode: str, reason: str) -> None:
    write_state(path, {"version": 1, "mode": mode, "reason": reason,
                       "changedAt": datetime.now(timezone.utc).isoformat()})


def load_fleet_config(path: Path) -> dict:
    try:
        if not stat.S_ISREG(path.stat().st_mode):
            raise ConfigError(f"{path}: expected a regular file for the deployment config")
        return load_config(path)
    except OSError as exc:
        raise ConfigError(f"cannot read {path}: {exc.strerror}") from None
    except (AttributeError, TypeError, ValueError) as exc:
        # Invalid TOML field types can fail before load_config collects its errors.
        raise ConfigError(f"{path}: invalid deployment config: {exc}") from None


def fleet_entries(fleet: Path, *, include_config: bool = False) -> list[dict]:
    try:
        paths = sorted(fleet.iterdir())
    except FileNotFoundError:
        return []
    entries = []
    for path in paths:
        if not path.match("*.toml"):
            continue
        entry = {"configPath": str(path)}
        try:
            if not path.is_symlink() and path.is_dir():
                continue
            cfg = load_fleet_config(path)
        except Exception as exc:
            entry["configError"] = str(exc)
            # Preserve the declared identity even when another field is invalid.
            try:
                cfg = tomllib.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
            except Exception:
                cfg = {}
        else:
            if include_config:
                entry["config"] = cfg
        name, repository = cfg.get("name"), cfg.get("repository")
        source = repository.get("source") if isinstance(repository, dict) else None
        entry.update(name=name if isinstance(name, str) else None,
                     repository=source if isinstance(source, str) else None)
        entries.append(entry)
    counts = Counter(entry["name"] for entry in entries if entry["name"] is not None)
    for entry in entries:
        if counts[entry["name"]] > 1:
            error = f"duplicate deployment name {entry['name']!r}; keep only one fleet config with that name"
            entry["configError"] = f"{error}; {entry['configError']}" if "configError" in entry else error
    return entries


def fleet_entry(fleet: Path, name: str, *, include_config: bool = False) -> dict | None:
    matches = [entry for entry in fleet_entries(fleet, include_config=include_config) if entry["name"] == name]
    if len(matches) > 1:
        raise ConfigError(matches[0]["configError"])
    return matches[0] if matches else None


def checkout_ax(report: Report, source: Path, pin: dict) -> bool:
    if not shutil.which("git"):
        return report.check("ax-source", False, "git not found on PATH", "install Git and retry enable")
    source.parent.mkdir(parents=True, exist_ok=True)
    fix = f"check access to {pin['repo']} at {pin['ref']} (docs/SETUP.md)"
    if source.exists():
        repair = f"move {source} aside and retry enable"
        try:
            top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=source,
                                 capture_output=True, text=True, timeout=30)
            # Git also succeeds inside subdirectories of an enclosing checkout.
            if top.returncode or Path(top.stdout.strip()) != source.resolve():
                return report.check("ax-source", False, f"{source} is not an AX checkout", repair)
            status = subprocess.run(["git", "status", "--porcelain", "--untracked-files=normal"], cwd=source,
                                    capture_output=True, text=True, timeout=30, check=True)
        except (OSError, subprocess.SubprocessError) as exc:
            return report.check("ax-source", False, str(exc), repair)
        if status.stdout:
            return report.check("ax-source", False, f"{source} has local changes", repair)
        ready = run_host_step(report, "ax-source", ["git", "fetch", "--", pin["repo"], pin["ref"]],
                              cwd=source, timeout=300, fix=fix)
    else:
        ready = run_host_step(report, "ax-source", ["git", "clone", "--no-checkout", "--",
                                                    pin["repo"], str(source)],
                              cwd=source.parent, timeout=300, fix=fix)
    return ready and run_host_step(report, "ax-source", ["git", "checkout", "--detach", pin["ref"]],
                                   cwd=source, timeout=300, fix=fix)


def prepare_enable(report: Report, cfg: dict, versions: dict) -> bool:
    state = state_home().absolute()
    source = state / "ax-source"
    pin = versions["ax"]
    pinned = pin["ref"][:12]
    ax_bin = ax_binary(cfg)
    found = shutil.which(ax_bin)
    verified, detail = ax_version(found, pinned) if found else (False, f"{ax_bin} not found or not executable")
    go_env = dict(os.environ, GOTOOLCHAIN="auto")
    if verified:
        report.check("ax-install", True, f"{found} matches {pinned}; skipped build")
    else:
        if cfg["ax"]["bin"] != "ax":
            return report.check("ax-install", False, detail,
                                f"build your configured AX command at {pinned}, or set [ax] bin = \"ax\" "
                                "to let enable install it (docs/SETUP.md)")
        if not shutil.which("go"):
            return report.check("ax-install", False, "go not found on PATH", "install Go and retry enable (docs/SETUP.md)")
        if not checkout_ax(report, source, pin):
            return False
        binary = state / "bin" / "ax"
        binary.parent.mkdir(parents=True, exist_ok=True)
        fix = f"build AX from a clean checkout at {pinned}; see docs/SETUP.md"
        if not run_host_step(report, "ax-install", ["go", "build", "-o", str(binary), "./cmd/ax"],
                             cwd=source, env=go_env, timeout=3600, fix=fix):
            return False
        built, detail = ax_version(str(binary), pinned)
        if not built:
            return report.check("ax-install", False, detail, fix)
        report.check("ax-install", True, f"built {binary} at {pinned}")

    ax = Ax(cfg)
    cluster = ax.run("get", "tasks", timeout=60)
    if cluster[0] == 0:
        report.check("ax-local", True, "control plane already reachable; skipped cluster startup")
    else:
        if not cfg["ax"]["local"]:
            return check_ax_cluster(report, cluster)
        if verified and not checkout_ax(report, source, pin):
            return False
        if not run_host_step(report, "ax-local", ["make", "build-local-cluster", "CONTAINER_CLI=docker"],
                             cwd=source, env=go_env, timeout=3600,
                             fix="check the local cluster prerequisites and Docker (docs/SETUP.md)"):
            return False
        cluster = ax.run("get", "tasks", timeout=60)
        if cluster[0] != 0:
            return check_ax_cluster(report, cluster)
        report.check("ax-local", True, "started the local AX cluster")

    host_checks(report, cfg, versions, cluster=True)
    return report.ok


def cmd_enable(args, report: Report) -> int:
    fleet = fleet_dir(args.fleet)
    try:
        if args.config is not None:
            config = args.config.absolute()
            cfg = load_fleet_config(config)
            name = cfg["name"]
            entry = fleet_entry(fleet, name)
            if entry is not None and not Path(entry["configPath"]).samefile(config):
                raise ConfigError(f"deployment {name!r} is already registered at {entry['configPath']}")
        else:
            name = args.name
            entry = fleet_entry(fleet, name, include_config=True)
            if entry is None:
                raise ConfigError(f"no fleet config named {name!r} in {fleet}; register it with enable --config PATH")
            if "configError" in entry:
                raise ConfigError(entry["configError"])
            cfg = entry["config"]

        if args.build_image:
            image = build_image(report, DEFAULT_IMAGE_REPOSITORY, engine=None, push=True)
            report.data.update(image)
            if not report.ok:
                return report.finish(EXIT_FAILED)
            if image["ref"] != cfg["image"]["ref"]:
                report.check("image-ref", False, "pushed digest differs from image.ref",
                             f'set this in your deployment config and retry:\n\n[image]\nref = "{image["ref"]}"')
                return report.finish(EXIT_FAILED)
        if not args.no_install and not prepare_enable(report, cfg, load_versions()):
            return report.finish(EXIT_FAILED)

        if args.config is not None and entry is None:
            fleet.mkdir(parents=True, exist_ok=True)
            link = fleet / f"{name}.toml"
            try:
                link.symlink_to(config)
            except FileExistsError:
                raise ConfigError(f"cannot register {name!r}: {link} already exists") from None
        write_desired(desired_path(name), "enabled", "")
    except (OSError, subprocess.TimeoutExpired) as exc:
        report.check("enable", False, str(exc))
        return report.finish(EXIT_FAILED)
    report.check("enable", True, f"{name} enabled")
    return report.finish(EXIT_OK)


def cmd_pause_resume(args, report: Report) -> int:
    name = args.name
    if not NAME_RE.match(name):
        raise ConfigError(f"invalid deployment name {name!r}")
    try:
        fleet_entry(fleet_dir(args.fleet), name)  # refuse ambiguous names even if a record exists
        path = desired_path(name)
        record = read_desired(path)
        if record is None:
            raise ConfigError(f"no desired-state record for {name!r}; enable it first")
        if args.command == "pause":
            mode = "paused"
            write_desired(path, mode, args.reason)
        else:
            mode = "enabled"
            if record["mode"] == "paused":
                write_desired(path, mode, "")
    except (OSError, ValueError) as exc:
        report.check(args.command, False, str(exc))
        return report.finish(EXIT_FAILED)
    report.check(args.command, True, f"{name} {mode}")
    return report.finish(EXIT_OK)


def cmd_status(args, report: Report) -> int:
    fleet = fleet_dir(args.fleet)
    deployments = []
    code = EXIT_OK
    try:
        for entry in fleet_entries(fleet):
            name = entry["name"]
            if args.name is not None and args.name != name:
                continue
            entry.update(desired="not-enabled", reason=None, changedAt=None)
            if name is not None and NAME_RE.match(name):
                path = desired_path(name)
                record = read_desired(path)
                if record is not None:
                    entry.update(desired=record["mode"], reason=record.get("reason"), changedAt=record.get("changedAt"))
                watch = read_state(path.with_name("watch.json"))
                # A fixed config that has never been enabled is no longer watched.
                stale_config_error = (watch is not None and watch.get("phase") == "config-error"
                                      and record is None and "configError" not in entry)
                if watch is not None and not stale_config_error:
                    entry["watch"] = watch
                    try:
                        at = datetime.fromisoformat(watch.get("at"))
                        entry["watchAgeSeconds"] = max(0, int((datetime.now(timezone.utc) - at).total_seconds()))
                    except (TypeError, ValueError):
                        pass
            deployments.append(entry)
            reason = f" ({entry['reason']})" if entry["reason"] else ""
            repository = f" ({entry['repository']})" if entry["repository"] else ""
            changed = f", changed at {entry['changedAt']}" if entry["changedAt"] else ""
            report.say(f"{name or '<unknown>'}{repository}: {entry['desired']}{reason}{changed} [{entry['configPath']}]")
            if "configError" in entry:
                report.say(f"  config error: {entry['configError']}")
            watch = entry.get("watch")
            if watch and watch.get("phase"):
                age = f" ({entry['watchAgeSeconds']}s ago)" if "watchAgeSeconds" in entry else ""
                report.say(f"  {watch['phase']}: {watch.get('detail', '')}{age}")
        if not deployments:
            if args.name is not None:
                print(f"no fleet config named {args.name!r} in {fleet}; register it with enable --config PATH",
                      file=sys.stderr)
                code = EXIT_USAGE
            else:
                report.say(f"no deployments in {fleet}")
    except (OSError, ValueError) as exc:
        print(f"cannot read fleet status: {exc}", file=sys.stderr)
        code = EXIT_FAILED
    report.data.pop("checks")  # status has a deployments envelope, not a check report
    return report.finish(code, deployments=deployments)


def watch_step(cfg: dict, state: dict, path: Path) -> tuple[str, str] | None:
    """Observe once, then make at most one change within a 120-second AX budget."""
    def still_enabled() -> bool:
        # An operator can pause (including via stop) while the observation is in flight.
        record = read_desired(path.with_name("desired.json"))
        state["desired"] = record["mode"] if record is not None else None
        return state["desired"] == "enabled"

    # A foreground Ctrl-C should reach watch, not cancel its current AX command.
    ax, task = Ax(cfg, start_new_session=True), names(cfg)["task"]
    observed = ax.task_state(task, timeout=40)
    state["taskState"] = "NotFound" if observed == "" else observed
    kind = TASK_CLASSES.get(observed, "unrecognised")
    if kind in ("missing", "checkpointed"):
        if kind == "missing":
            args, stdin = ("apply", "-f", "-"), render(cfg)
            phase, detail = "preparing", "Creating the sandbox"
        else:
            args, stdin = ("resume", "task", task), None
            phase, detail = "resuming", "Restoring the sandbox"
        if not still_enabled():
            return None
        code, out, err = ax.run(*args, stdin=stdin, timeout=80)
        if code != 0:
            raise RuntimeError(f"{detail} failed: {(err or out).strip() or f'AX exited {code}'}")
        return phase, detail
    if kind == "unreachable":
        return "waiting", "Waiting for AX to answer"
    if kind == "transitional":
        return "waiting", f"Waiting for the sandbox while it is {observed}"
    if kind == "failed":
        return "blocked", f"Sandbox task is {observed}"
    if kind != "active":
        return "blocked", f"Unrecognised AX state {observed!r}"

    pending = state["pendingTick"]
    query = ["--run", pending["id"]] if pending else []
    # --run still returns health and counts (with a nonzero exit) for an unknown ID.
    status, err = ax.agent(task, "status", "--json", *query, timeout=40, allow_status_error=bool(pending))
    now = datetime.now(timezone.utc)
    if not status or not status.get("started"):
        state["startingSince"] = state["startingSince"] or now.isoformat()
        return "starting", "Waiting for the sandbox agent to start"
    state["startingSince"] = None
    prepare = Report(as_json=True)
    if not report_prepare(prepare, status, err):
        failure = next((check["detail"] for check in prepare.data["checks"] if check["ok"] is False),
                       "prepare checks did not pass")
        return "blocked", f"Sandbox is not ready: {' '.join(failure.split())}"

    current = (status.get("health") or {}).get("currentRun") if status.get("supervisorAlive") else None
    if current:
        return "ticking", f"Orbi tick {current} is running"
    if (status.get("counts") or {}).get("queued"):
        return "ticking", "An Orbi tick is queued"

    runs = status.get("runs") or []
    run = runs[0] if pending and runs and runs[0].get("id") == pending["id"] else {}
    if run.get("status") in ("succeeded", "failed", "interrupted"):
        next_action = now + timedelta(seconds=cfg["watch"]["tick_interval"])
        state.update(lastTick={key: run.get(key) for key in ("id", "status", "finishedAt")},
                     pendingTick=None, nextActionAt=next_action.isoformat())
        return "idle", f"Next tick at {next_action:%H:%M UTC}"
    if not pending and state["nextActionAt"]:
        next_action = datetime.fromisoformat(state["nextActionAt"])
        if now < next_action:
            return "idle", f"Next tick at {next_action:%H:%M UTC}"

    if not still_enabled():
        return None
    if pending is None:
        pending = {"id": f"watch-{now:%Y%m%dT%H%M%SZ}-{secrets.token_hex(3)}", "requestedAt": now.isoformat()}
        state["pendingTick"] = pending
    state.update(at=now.isoformat(), phase="ticking", detail=f"Requesting Orbi tick {pending['id']}")
    write_state(path, state)  # Make the id durable even if a prior write failed after rename.
    if not still_enabled():
        return None
    answer, err = ax.agent(task, "request-tick", "--id", pending["id"], timeout=40)
    if not answer:
        raise RuntimeError(f"Could not request Orbi tick {pending['id']}: {err}")
    return "ticking", f"Requested Orbi tick {pending['id']}"


def watch_deployment(entry: dict) -> None:
    name = entry["name"]
    if not name or not NAME_RE.match(name):
        return  # Only status reports configurations with no valid identity.
    desired = desired_path(name)
    path = desired.with_name("watch.json")
    state = dict(desired=None, taskState=None, pendingTick=None, lastTick=None,
                 nextActionAt=None, startingSince=None)
    try:
        state.update(read_state(path) or {})
        state.update(version=1, deployment=name, desired=None, taskState=None)
        record = read_desired(desired)
        if record is not None:
            state["desired"] = record["mode"]
        if "configError" in entry:
            phase, detail = "config-error", entry["configError"]
        elif record is None:
            return
        else:
            cfg = entry["config"]
            if "notify_command" in cfg["watch"]:
                state["notifyCommand"] = cfg["watch"]["notify_command"]
            step = watch_step(cfg, state, path) if record["mode"] == "enabled" else None
            if state["desired"] is None:
                return
            phase, detail = step if step is not None else ("paused", "Deployment is paused")
    except Exception as exc:
        phase, detail = "blocked", str(exc) or type(exc).__name__
    state.update(version=1, deployment=name, at=datetime.now(timezone.utc).isoformat(),
                 phase=phase, detail=" ".join(detail.split()))
    try:
        write_state(path, state)
    except Exception as exc:
        print(f"Cannot write watch state for {name}: {exc}", file=sys.stderr)


def cmd_watch(args, report: Report) -> int:
    if args.print_unit:
        executable = str(ROOT / "bin" / "ax-orbi").replace("%", "%%")
        if re.search(r"[\s\"'\\]", executable):
            executable = json.dumps(executable, ensure_ascii=False)
        unit = ("[Unit]\nDescription=ax-orbi fleet watch\n\n"
                f"[Service]\nExecStart={executable} watch\nRestart=on-failure\n"
                "KillMode=mixed\nTimeoutStopSec=125s\n\n[Install]\nWantedBy=default.target\n")
        report.say(unit.rstrip())
        return report.finish(EXIT_OK, unit=unit)
    if not 0 < args.interval < float("inf"):
        raise ConfigError("--interval must be a positive number of seconds")

    lock_path = state_home() / "watch.lock"
    stop = False

    def request_stop(_signal, _frame):
        nonlocal stop
        stop = True

    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        with lock_path.open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                report.check("watch", False, f"Another ax-orbi watch holds {lock_path}",
                             "stop that instance before starting another")
                return report.finish(EXIT_FAILED)
            signals = (signal.SIGTERM, signal.SIGINT)
            previous = [signal.signal(sig, request_stop) for sig in signals]
            try:
                fleet = fleet_dir(args.fleet)
                while not stop:
                    for entry in fleet_entries(fleet, include_config=True):
                        if stop:
                            break
                        watch_deployment(entry)
                    if args.once:
                        break
                    deadline = time.monotonic() + args.interval
                    while not stop and (remaining := deadline - time.monotonic()) > 0:
                        time.sleep(min(1, remaining))
            finally:
                for sig, handler in zip(signals, previous):
                    signal.signal(sig, handler)
    except OSError as exc:
        report.check("watch", False, str(exc))
        return report.finish(EXIT_FAILED)
    return report.finish(EXIT_OK)


def pause_for_stop(name: str, report: Report) -> bool:
    path = desired_path(name)
    reason = "stopped with ax-orbi stop"
    try:
        record = read_desired(path)
        if record is not None and record["mode"] == "enabled":
            write_desired(path, "paused", reason)
            report.check("pause", True, f"{name} paused: {reason}")
    except (OSError, ValueError) as exc:
        return report.check("pause", False, str(exc))
    return True


def cmd_stop(args, report: Report) -> int:
    cfg = load_config(args.config)
    ax, n = Ax(cfg), names(cfg)
    task = n["task"]
    state = ax.task_state(task)
    report.data["taskState"] = "NotFound" if state == "" else state
    kind = TASK_CLASSES.get(state, "unrecognised")
    if args.delete:
        if not args.yes_delete_state:
            report.check("delete", False, "deleting removes the sandbox and its /workspace: "
                         "the checkout, unpushed worktrees, Pi sessions and every run record",
                         "repeat with --delete --yes-delete-state if that is what you want")
            return report.finish(EXIT_USAGE)
        detail = {"missing": f"task {task} does not exist",
                  "unreachable": "cannot reach the AX control plane to observe the task"}
        report.check("task", None, detail.get(kind, f"{task} reported state {state!r}"))
        if not pause_for_stop(cfg["name"], report):
            return report.finish(EXIT_FAILED)
        for resource, name in (("task", task), ("workspace", n["workspace"]), ("gateway", n["gateway"])):
            code, out, err = ax.run("delete", resource, name)
            # Only AX's resource-level NotFound confirms the resource is already absent.
            not_found = (f"Error: deleting {resource} {cfg['ax']['atespace']}/{name}: "
                         f'rpc error: code = NotFound desc = {resource} "{name}" not found in atespace ')
            absent = code == 1 and any(line.startswith(not_found) for line in err.splitlines())
            detail = (f"{name} deleted" if code == 0 else f"{name} already absent" if absent
                      else (err or out).strip() or f"ax delete {resource} exited {code}")
            report.check(f"delete:{resource}", code == 0 or absent, detail)
        return report.finish(EXIT_OK if report.ok else EXIT_FAILED, interruptedRun=None)
    if kind in ("missing", "checkpointed"):
        if not pause_for_stop(cfg["name"], report):
            return report.finish(EXIT_FAILED)
        if kind == "missing":
            report.check("task", None, f"task {task} does not exist; nothing to stop")
            return report.finish(EXIT_OK)
        report.check("suspend", True, f"{task} is already {state}")
        return report.finish(EXIT_OK, interruptedRun=None)
    if kind != "active":
        return report.finish(report_task_error(report, task, state, kind))

    status, err = ax.agent(task, "status", "--json")
    status = status or {}
    health = status.get("health")
    health = health if isinstance(health, dict) else {}
    counts = status.get("counts")
    current = health.get("currentRun")
    alive = status.get("supervisorAlive") is True
    running = current if alive and isinstance(current, str) and current else None
    idle = (alive and health.get("state") == "idle" and "currentRun" in health
            and current in (None, "") and isinstance(counts, dict)
            and "queued" not in counts and "running" not in counts)
    if running and not args.force:
        report.check("stop", False, f"tick {running} is running",
                     "wait for it (`ax-orbi inspect`), or stop anyway with --force: the tick is "
                     "recorded as interrupted and Orbi resumes that delivery on the next tick")
        return report.finish(EXIT_FAILED)
    if not idle and not running:
        report.check("stop", None if args.force else False,
                     "cannot confirm the sandbox is idle; execution is unknown or active"
                     + (f": {err}" if err else ""),
                     "check `ax-orbi inspect` and retry, or stop anyway with --force" if not args.force else "")
        if not args.force:
            return report.finish(EXIT_INTERRUPTED)
        report.data["executionUnknown"] = True
    if not pause_for_stop(cfg["name"], report):
        return report.finish(EXIT_FAILED)
    code, out, err = ax.run("suspend", "task", task)
    if not report.check("suspend", code == 0,
                        f"{task} checkpointed; /workspace is kept" if code == 0 else (err or out).strip()):
        return report.finish(EXIT_FAILED)
    return report.finish(EXIT_OK, interruptedRun=running)


def cmd_recover(args, report: Report) -> int:
    cfg = load_config(args.config)
    ax, n = Ax(cfg), names(cfg)
    deadline = time.monotonic() + args.timeout
    code = ensure_working(ax, n["task"], report, deadline)
    if code != EXIT_OK:
        return report.finish(code)
    status, err = wait_for_agent(ax, n["task"], deadline)
    ready = report_prepare(report, status, err)
    runs = (status or {}).get("runs", [])
    interrupted = [r for r in runs if r.get("status") == "interrupted"]
    queued = [r for r in runs if r.get("status") in ("queued", "running")]
    for run in interrupted:
        describe_run(report, run)
    if interrupted:
        report.say("interrupted ticks are kept as evidence and are not re-run. Orbi tracks each "
                   "delivery in GitHub labels, so `ax-orbi run` picks the work up where it stopped.")
    for run in queued:
        report.say(f"run {run['id']} was requested before the stop and never started; it runs now.")
    if ready and not interrupted and not queued:
        report.say("recovered; nothing was interrupted.")
    return report.finish(EXIT_OK if ready and report.ok else EXIT_FAILED,
                         interrupted=[r["id"] for r in interrupted])


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-c", "--config", type=Path, default=Path("ax-orbi.toml"),
                        help="deployment config (default: ./ax-orbi.toml)")
    common.add_argument("--json", action="store_true", help="print one JSON object")
    parser = argparse.ArgumentParser(prog="ax-orbi", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("check", parents=[common], help="prerequisites, pins and config")
    p.add_argument("--offline", action="store_true", help="skip the checks that need the cluster")
    p = sub.add_parser("build", parents=[common], help="build the task image from versions.toml")
    p.add_argument("--repository", default=DEFAULT_IMAGE_REPOSITORY,
                   help="image repository (default: localhost:5001/ax-orbi, the AX local registry)")
    p.add_argument("--push", action="store_true", help="push and print the digest reference")
    p.add_argument("--engine", choices=["docker", "podman"])
    sub.add_parser("render", parents=[common], help="print the AX manifests")
    p = sub.add_parser("prepare", parents=[common], help="create and start the sandbox; no delivery")
    p.add_argument("--timeout", type=int, default=300, help="seconds to wait for the agent")
    p = sub.add_parser("run", parents=[common], help="run one Orbi tick")
    p.add_argument("--id", help="run id; repeating one never starts a second execution")
    p.add_argument("--timeout", type=int, default=0, help="stop waiting after N seconds (0: wait)")
    p.add_argument("--start-timeout", type=int, default=300)
    p.add_argument("--poll", type=int, default=10, help="seconds between status checks")
    p.add_argument("--no-wait", action="store_true", help="request the tick and return")
    p = sub.add_parser("inspect", parents=[common], help="health, runs and evidence")
    p.add_argument("--run", help="show one run")
    p.add_argument("--limit", type=int, default=5)
    p.add_argument("--logs", action="store_true", help="print the end of the run's log")
    p.add_argument("--tail", type=int, default=100)
    p = sub.add_parser("stop", parents=[common], help="checkpoint the sandbox; state is kept",
                       description="Without --force, suspending requires an idle observation. "
                                   "A request can arrive between the observation and the suspend.")
    p.add_argument("--force", action="store_true", help="stop even if a tick is active or execution is unknown")
    p.add_argument("--delete", action="store_true", help="delete the sandbox and its state instead of suspending")
    p.add_argument("--yes-delete-state", action="store_true")
    p = sub.add_parser("recover", parents=[common], help="resume and report interrupted runs")
    p.add_argument("--timeout", type=int, default=300)

    fleet = argparse.ArgumentParser(add_help=False)
    fleet.add_argument("--fleet", type=Path, help="fleet config directory (overrides AX_ORBI_FLEET)")
    fleet.add_argument("--json", action="store_true", help="print one JSON object")
    p = sub.add_parser("enable", parents=[fleet], help="prepare the host and enable a fleet deployment")
    p.add_argument("--no-install", action="store_true", help="skip AX installation, cluster startup and host checks")
    p.add_argument("--build-image", action="store_true", help="build and push the task image before enabling")
    target = p.add_mutually_exclusive_group(required=True)
    target.add_argument("name", nargs="?", metavar="NAME")
    target.add_argument("--config", "-c", type=Path, metavar="PATH", help="register a deployment config")
    p = sub.add_parser("pause", parents=[fleet], help="pause a deployment")
    p.add_argument("name", metavar="NAME")
    p.add_argument("--reason", default="", help="reason to record with the pause")
    p = sub.add_parser("resume", parents=[fleet], help="re-enable a paused deployment")
    p.add_argument("name", metavar="NAME")
    p = sub.add_parser("status", parents=[fleet], help="list fleet deployments and watch activity")
    p.add_argument("name", nargs="?", metavar="NAME")
    p = sub.add_parser("watch", parents=[fleet], help="keep enabled fleet deployments ticking")
    p.add_argument("--once", action="store_true", help="make one pass and exit")
    p.add_argument("--interval", type=float, default=30, metavar="SECONDS",
                   help="sleep between passes (default: 30 seconds)")
    p.add_argument("--print-unit", action="store_true", help="only print a systemd user unit")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    report = Report(args.json)
    handler = {"check": cmd_check, "build": cmd_build, "render": cmd_render, "prepare": cmd_prepare,
               "run": cmd_run, "inspect": cmd_inspect, "stop": cmd_stop, "recover": cmd_recover,
               "enable": cmd_enable, "pause": cmd_pause_resume, "resume": cmd_pause_resume,
               "status": cmd_status, "watch": cmd_watch}
    try:
        return handler[args.command](args, report)
    except ConfigError as exc:
        report.check("config", False, str(exc))
        return report.finish(EXIT_USAGE)


if __name__ == "__main__":
    sys.exit(main())
